<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Last source again after a reboot (option). -->
    <!-- Open Headunit's LibreHU fork: RAISE_PROJECTION through its automation receiver (signature permission). -->
    <uses-permission android:name="org.librehu.headunit.permission.CONFIGURE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <!-- Media apps (as Android Auto finds them) and apps with an icon, to add as sources. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <package android:name="org.librehu.service" />
        <package android:name="org.librehu.fm" />
        <package android:name="com.android.bluetooth" />
        <!-- Android Auto (Open Headunit) and CarPlay: opened in front -->
        <package android:name="org.librehu.headunit" />
        <package android:name="com.andrerinas.headunitrevived" />
        <package android:name="org.librehu.carplay" />
        <package android:name="com.shilapi.xcertplay" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreHU.Car">
        <!-- Single-colour icon: LibreHU Launcher draws it in the colours of its theme. -->
        <meta-data
            android:name="org.librehu.themed_icon"
            android:resource="@drawable/ic_launcher_mono" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Source picker, for a steering wheel key (LibreHU BtnRemap: open an app, or these actions). -->
        <activity
            android:name=".SwitcherActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="org.librehu.easysource.switcher"
            android:theme="@style/Theme.LibreHU.Overlay">
            <intent-filter>
                <action android:name="org.librehu.easysource.action.NEXT" />
                <action android:name="org.librehu.easysource.action.PREVIOUS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
